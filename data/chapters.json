    "story": {
      "start": [
        {
          "who": "radio",
          "text": "Able Company, this is Hearth. The Vossmark hold the whole eastern seaboard. You're the spearhead out of Denver."
        },
        {
          "who": "radio",
          "text": "Recon keeps reporting a tank in New York that shrugs off bazookas. Some say it glows. Probably nerves."
        },
        {
          "who": "hero",
          "text": "Copy, Hearth. Probably nerves."
        }
      ],
      "mid": [
        {
          "who": "radio",
          "text": "Pittsburgh is a fortress. There's an MG bunker covering the river crossings. Bring sappers if you have them."
        }
      ],
      "end": [
        {
          "who": "hero",
          "text": "That's it. That's the tank. Look at the hull."
        },
        {
          "who": "radio",
          "text": "Those marks are not paint. Whatever the Lantern Bureau did to it, put it down. It's armor, so hit it with charges."
        }
      ],
      "win": [
        {
          "who": "radio",
          "text": "New York is free. Ships are waiting to take you across the Atlantic. Europe is next."
        }
      ]
    }
